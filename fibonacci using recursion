class Main {
    public static int val(int n) {
        if (n == 0)
            return 0;

        if (n == 1)
            return 1;

        return val(n - 1) + val(n - 2);
    }

    public static void main(String[] args) {
        int n = 10;

        for (int i = 0; i < n; i++) {
            System.out.print(val(i) + " ");
        }
    }
}
