public class Main
{
    public static int lcm(int a, int b)
    {
        int big = Math.max(a,b);
        int small = Math.min(a,b);
        int s = big;
        while(true)
        {
            if(big%small==0)
            break;
            big = big+s;
        }
        return big;
    }
    public static void main(String args[])
    {
        int[] a = {8, 7, 10, 14, 2, 12};
        int lcm = a[0];
        for(int i = 1; i<6; i++)
        {
            lcm = lcm(lcm, a[i]);
        }
        System.out.println("The lcm is " + lcm);
    }
}
